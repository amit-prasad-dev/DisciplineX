{
  "name": "disciplinex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-disciplinex \"vitest run --config vitest.rules.config.js\"",
    "check:rules": "node scripts/check-rules.mjs",
    "deploy:rules": "npm run check:rules && firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "firebase": "^13.4.0",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.37.0",
    "oxlint": "^1.94.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
